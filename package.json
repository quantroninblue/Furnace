{
  "name": "furnace",
  "version": "0.2.1",
  "private": true,
  "description": "Furnace: a desktop coding workspace built on Code OSS where you and an AI agent work on the same project.",
  "license": "MIT",
  "scripts": {
    "build": "node prototypes/code-oss/scripts/build-product.mjs",
    "start": "node prototypes/code-oss/scripts/start.mjs",
    "test": "node --import tsx --test prototypes/shared/*.test.cjs prototypes/code-oss/product/*.test.cjs prototypes/shared/assistant/tests/*.test.ts prototypes/shared/assistant/*.test.cjs",
    "test:research": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/research-smoke.mjs",
    "test:browser": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/browser-smoke.mjs",
    "test:browser-integration": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/browser-integration-smoke.mjs",
    "test:shell": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/product-smoke.mjs",
    "test:review": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/review-smoke.mjs",
    "test:assistant": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/assistant-smoke.mjs",
    "typecheck": "tsc --noEmit -p prototypes/shared/assistant/tsconfig.json && tsc --noEmit -p prototypes/code-oss/product/webview/tsconfig.json",
    "test:trust": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/trust-smoke.mjs",
    "test:debug": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/debug-smoke.mjs",
    "test:webview": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/webview-smoke.mjs",
    "test:themes": "node prototypes/code-oss/scripts/test-display.mjs prototypes/code-oss/scripts/themes-smoke.mjs",
    "format": "prettier --write \"prototypes/**/*.{cjs,mjs,ts,tsx,css}\"",
    "format:check": "prettier --check \"prototypes/**/*.{cjs,mjs,ts,tsx,css}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "jose": "6.2.12",
    "openai": "7.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1"
  }
}
