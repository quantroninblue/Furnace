{
  "name": "workspace-product",
  "displayName": "AI GUI Workspace",
  "description": "Private foundation comparison: conversations, planning and reviewed edits.",
  "publisher": "ai-gui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "aiGui.home",
        "title": "AI GUI: Open Workspace"
      },
      {
        "command": "aiGui.tour",
        "title": "AI GUI: Getting Started"
      },
      {
        "command": "aiGui.connections",
        "title": "AI GUI: Connections"
      },
      {
        "command": "aiGui.proposeFixture",
        "title": "AI GUI: Propose Example Edit"
      },
      {
        "command": "aiGui.applyReview",
        "title": "AI GUI: Apply Reviewed Changes"
      },
      {
        "command": "aiGui.discardReview",
        "title": "AI GUI: Discard Proposal"
      },
      {
        "command": "aiGui.openResearch",
        "title": "AI GUI: Open Research"
      },
      {
        "command": "aiGui.focusConversation",
        "title": "AI GUI: Focus Conversation",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aiGui.newChat",
        "title": "AI GUI: New Chat"
      },
      {
        "command": "aiGui.history",
        "title": "AI GUI: Chat History"
      },
      {
        "command": "aiGui.nextMode",
        "title": "AI GUI: Next Mode (Discuss, Plan, Build, Research)"
      },
      {
        "command": "aiGui.stop",
        "title": "AI GUI: Stop Reply"
      },
      {
        "command": "aiGui.approve",
        "title": "AI GUI: Approve Pending Action"
      },
      {
        "command": "aiGui.deny",
        "title": "AI GUI: Deny Pending Action"
      },
      {
        "command": "aiGui.compact",
        "title": "AI GUI: Condense Conversation Now"
      },
      {
        "command": "aiGui.copyDiagnostics",
        "title": "AI GUI: Copy Diagnostics for a Bug Report"
      },
      {
        "command": "aiGui.showLog",
        "title": "AI GUI: Show Log"
      },
      {
        "command": "aiGui.scm.open",
        "title": "Show Agent Changes",
        "icon": "$(diff)"
      },
      {
        "command": "aiGui.scm.revert",
        "title": "Revert Agent Changes",
        "icon": "$(discard)"
      },
      {
        "command": "aiGui.scm.stage",
        "title": "Stage in Git",
        "icon": "$(add)"
      },
      {
        "command": "aiGui.scm.stageAll",
        "title": "Stage All Agent Changes in Git",
        "icon": "$(add)"
      },
      {
        "command": "aiGui.scm.reviewAll",
        "title": "Review All Agent Changes",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "aiGui.inlineEdit",
        "title": "AI GUI: Inline Edit Selection"
      },
      {
        "command": "aiGui.inlineEdit.accept",
        "title": "AI GUI: Accept Inline Edit"
      },
      {
        "command": "aiGui.inlineEdit.reject",
        "title": "AI GUI: Reject Inline Edit"
      },
      {
        "command": "aiGui.inlineEdit.cancel",
        "title": "AI GUI: Cancel Inline Edit"
      },
      {
        "command": "aiGui.inlineEdit.diff",
        "title": "AI GUI: Show Inline Edit Diff"
      },
      {
        "command": "aiGui.agentHunk.keep",
        "title": "AI GUI: Keep Agent Change"
      },
      {
        "command": "aiGui.agentHunk.revert",
        "title": "AI GUI: Revert Agent Change"
      },
      {
        "command": "aiGui.background.start",
        "title": "AI GUI: Start Background Task"
      },
      {
        "command": "aiGui.timeline",
        "title": "AI GUI: Conversation Timeline"
      },
      {
        "command": "aiGui.reviewLastChanges",
        "title": "AI GUI: Second Opinion on Last Changes"
      },
      {
        "command": "aiGui.sendFeedback",
        "title": "AI GUI: Send Feedback"
      },
      {
        "command": "aiGui.checkForUpdates",
        "title": "AI GUI: Check for Updates"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aiGui",
          "title": "Conversation",
          "icon": "media/workspace.svg"
        }
      ],
      "activitybar": [
        {
          "id": "aiGuiWorkspace",
          "title": "AI GUI Workspace",
          "icon": "media/workspace.svg"
        }
      ]
    },
    "views": {
      "aiGui": [
        {
          "id": "aiGui.conversation",
          "name": "Conversation",
          "type": "webview"
        }
      ],
      "aiGuiWorkspace": [
        {
          "id": "aiGui.workspace",
          "name": "Workspace",
          "type": "webview"
        }
      ]
    },
    "themes": [
      {
        "label": "AI GUI Charcoal",
        "uiTheme": "vs-dark",
        "path": "./themes/charcoal.json"
      }
    ],
    "configuration": {
      "title": "AI GUI",
      "properties": {
        "aiGui.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the product workspace and conversation on startup."
        },
        "aiGui.agent.permissions": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "full"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Ask before every file change, command and web fetch.",
            "Apply project edits directly and run commands in the sandbox (project + temp writes, no network); ask for anything else.",
            "Full access (YOLO): no approvals and no sandbox."
          ],
          "description": "How much the agent may do without asking. Changeable from the conversation composer."
        },
        "aiGui.agent.showCommandsInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Show the agent's commands and background processes live in IDE terminals (Ctrl+C there interrupts them)."
        },
        "aiGui.review.automatic": {
          "type": "boolean",
          "default": false,
          "description": "After each Build reply that changes files, a second model reviews the changes and its notes appear under the changed files (costs an extra request)."
        },
        "aiGui.review.model": {
          "type": "string",
          "default": "",
          "description": "Model that reviews changes (an id such as anthropic/claude-sonnet-5-5). Empty: the model that made the changes."
        },
        "aiGui.budget.monthlyUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Monthly API spend (US dollars) that AI GUI warns about, counted from replies made with API keys on this machine. 0: no warning."
        },
        "aiGui.pricing": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              }
            }
          },
          "description": "Price overrides in US dollars per million tokens, keyed by model id, for example {\"openai/gpt-5\": {\"input\": 1.25, \"output\": 10}}."
        },
        "aiGui.updates.check": {
          "type": "boolean",
          "default": true,
          "description": "Check once a day whether a newer AI GUI is available (only when this build names an update feed). Nothing else is sent."
        },
        "aiGui.support.developerTools": {
          "type": "boolean",
          "default": false,
          "description": "Show Toggle Developer Tools and Process Explorer in release builds (for troubleshooting). Takes effect after a restart."
        }
      }
    },
    "configurationDefaults": {
      "workbench.activityBar.location": "top",
      "workbench.layoutControl.enabled": false,
      "workbench.tips.enabled": false,
      "window.title": "${dirty}${rootName}${separator}AI GUI",
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "gutter"
    },
    "menus": {
      "scm/resourceState/context": [
        {
          "command": "aiGui.scm.revert",
          "when": "scmProvider == aiGui && scmResourceState == revertible",
          "group": "inline"
        },
        {
          "command": "aiGui.scm.stage",
          "when": "scmProvider == aiGui",
          "group": "inline"
        },
        {
          "command": "aiGui.scm.revert",
          "when": "scmProvider == aiGui && scmResourceState == revertible",
          "group": "1_modification"
        },
        {
          "command": "aiGui.scm.stage",
          "when": "scmProvider == aiGui",
          "group": "1_modification"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "aiGui.scm.reviewAll",
          "when": "scmProvider == aiGui",
          "group": "inline"
        },
        {
          "command": "aiGui.scm.stageAll",
          "when": "scmProvider == aiGui",
          "group": "inline"
        }
      ],
      "scm/title": [
        {
          "command": "aiGui.focusConversation",
          "when": "scmProvider == aiGui",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "aiGui.scm.open",
          "when": "false"
        },
        {
          "command": "aiGui.scm.revert",
          "when": "false"
        },
        {
          "command": "aiGui.scm.stage",
          "when": "false"
        },
        {
          "command": "aiGui.inlineEdit.accept",
          "when": "aiGui.inlineEditPending"
        },
        {
          "command": "aiGui.inlineEdit.reject",
          "when": "aiGui.inlineEditPending"
        },
        {
          "command": "aiGui.inlineEdit.diff",
          "when": "aiGui.inlineEditPending"
        },
        {
          "command": "aiGui.inlineEdit.cancel",
          "when": "aiGui.inlineEditRunning"
        },
        {
          "command": "aiGui.agentHunk.keep",
          "when": "false"
        },
        {
          "command": "aiGui.agentHunk.revert",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "aiGui.inlineEdit",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiGui.focusConversation",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "aiGui.newChat",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "aiGui.history",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      },
      {
        "command": "aiGui.nextMode",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "aiGui.home",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      },
      {
        "command": "aiGui.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "aiGui.busy"
      },
      {
        "command": "aiGui.approve",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "aiGui.approvalPending && !findWidgetVisible"
      },
      {
        "command": "aiGui.deny",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "aiGui.approvalPending"
      },
      {
        "command": "aiGui.inlineEdit",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && !editorReadonly && !aiGui.inlineEditPending"
      },
      {
        "command": "aiGui.inlineEdit.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && aiGui.inlineEditPending"
      },
      {
        "command": "aiGui.inlineEdit.reject",
        "key": "escape",
        "when": "editorTextFocus && aiGui.inlineEditPending && !suggestWidgetVisible && !inlineSuggestionVisible && !findWidgetVisible"
      },
      {
        "command": "aiGui.inlineEdit.cancel",
        "key": "escape",
        "when": "aiGui.inlineEditRunning"
      }
    ],
    "walkthroughs": [
      {
        "id": "aiGui.start",
        "title": "Get Started with AI GUI",
        "description": "Connect a model, open a project and run a first reviewed task.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect a model",
            "description": "Use your ChatGPT plan, Claude Code, an API key or a local Ollama model. Nothing switches accounts or billing on its own.\n[Open Connections](command:aiGui.connections)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:aiGui.connections"
            ]
          },
          {
            "id": "project",
            "title": "Open a project",
            "description": "The agent works inside the folder you open and trust.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.files.openFolder",
              "onContext:workspaceFolderCount > 0"
            ]
          },
          {
            "id": "permissions",
            "title": "Choose what the agent may do",
            "description": "Ask first, Auto (sandboxed commands) or Full access, from the box under the message field.\n[Focus the Conversation](command:aiGui.focusConversation)",
            "media": {
              "markdown": "media/walkthrough/permissions.md"
            }
          },
          {
            "id": "task",
            "title": "Run a first task",
            "description": "Pick the Build page, describe a small change, and watch each step and diff.\n[Open the Workspace](command:aiGui.home)",
            "media": {
              "markdown": "media/walkthrough/task.md"
            },
            "completionEvents": [
              "onCommand:aiGui.home"
            ]
          },
          {
            "id": "review",
            "title": "Review, revert or rewind",
            "description": "Every reply lists the files it changed. Review diffs, keep or revert blocks in the editor, ask a second model for an opinion, or rewind from the timeline.\n[Open the Timeline](command:aiGui.timeline)",
            "media": {
              "markdown": "media/walkthrough/review.md"
            },
            "completionEvents": [
              "onCommand:aiGui.timeline"
            ]
          },
          {
            "id": "privacy",
            "title": "Your data stays yours",
            "description": "No AI GUI account and no telemetry. Conversations, rules and the activity log stay on this device; only what you send goes to the model you chose.",
            "media": {
              "markdown": "media/walkthrough/privacy.md"
            }
          }
        ]
      }
    ]
  },
  "enabledApiProposals": [
    "workspaceTrust"
  ],
  "support": {
    "issues": "",
    "email": ""
  },
  "updates": {
    "feed": ""
  }
}
