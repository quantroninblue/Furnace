{
  "name": "workspace-product",
  "displayName": "Furnace Workspace",
  "description": "Private foundation comparison: conversations, planning and reviewed edits.",
  "publisher": "ai-gui",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "aiGui.home",
        "title": "Furnace: Open Workspace"
      },
      {
        "command": "aiGui.tour",
        "title": "Furnace: Begin Tutorial"
      },
      {
        "command": "aiGui.help",
        "title": "Furnace: Help"
      },
      {
        "command": "aiGui.connections",
        "title": "Furnace: Connections"
      },
      {
        "command": "aiGui.proposeFixture",
        "title": "Furnace: Propose Example Edit"
      },
      {
        "command": "aiGui.applyReview",
        "title": "Furnace: Apply Reviewed Changes"
      },
      {
        "command": "aiGui.discardReview",
        "title": "Furnace: Discard Proposal"
      },
      {
        "command": "aiGui.openResearch",
        "title": "Furnace: Open Research"
      },
      {
        "command": "aiGui.focusConversation",
        "title": "Furnace: Focus Conversation",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aiGui.newChat",
        "title": "Furnace: New Chat"
      },
      {
        "command": "aiGui.history",
        "title": "Furnace: Chat History"
      },
      {
        "command": "aiGui.nextMode",
        "title": "Furnace: Next Mode (Discuss, Plan, Build, Research)"
      },
      {
        "command": "aiGui.stop",
        "title": "Furnace: Stop Reply"
      },
      {
        "command": "aiGui.approve",
        "title": "Furnace: Approve Pending Action"
      },
      {
        "command": "aiGui.deny",
        "title": "Furnace: Deny Pending Action"
      },
      {
        "command": "aiGui.compact",
        "title": "Furnace: Condense Conversation Now"
      },
      {
        "command": "aiGui.copyDiagnostics",
        "title": "Furnace: Copy Diagnostics for a Bug Report"
      },
      {
        "command": "aiGui.showLog",
        "title": "Furnace: Show Log"
      },
      {
        "command": "aiGui.scm.open",
        "title": "Show Agent Changes",
        "icon": "$(diff)"
      },
      {
        "command": "aiGui.scm.revert",
        "title": "Revert Agent Changes",
        "icon": "$(discard)"
      },
      {
        "command": "aiGui.scm.stage",
        "title": "Stage in Git",
        "icon": "$(add)"
      },
      {
        "command": "aiGui.scm.stageAll",
        "title": "Stage All Agent Changes in Git",
        "icon": "$(add)"
      },
      {
        "command": "aiGui.scm.reviewAll",
        "title": "Review All Agent Changes",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "aiGui.inlineEdit",
        "title": "Furnace: Inline Edit Selection"
      },
      {
        "command": "aiGui.inlineEdit.accept",
        "title": "Furnace: Accept Inline Edit"
      },
      {
        "command": "aiGui.inlineEdit.reject",
        "title": "Furnace: Reject Inline Edit"
      },
      {
        "command": "aiGui.inlineEdit.cancel",
        "title": "Furnace: Cancel Inline Edit"
      },
      {
        "command": "aiGui.inlineEdit.diff",
        "title": "Furnace: Show Inline Edit Diff"
      },
      {
        "command": "aiGui.agentHunk.keep",
        "title": "Furnace: Keep Agent Change"
      },
      {
        "command": "aiGui.agentHunk.revert",
        "title": "Furnace: Revert Agent Change"
      },
      {
        "command": "aiGui.background.start",
        "title": "Furnace: Start Background Task"
      },
      {
        "command": "aiGui.timeline",
        "title": "Furnace: Conversation Timeline"
      },
      {
        "command": "aiGui.reviewLastChanges",
        "title": "Furnace: Second Opinion on Last Changes"
      },
      {
        "command": "aiGui.sendFeedback",
        "title": "Furnace: Send Feedback"
      },
      {
        "command": "aiGui.checkForUpdates",
        "title": "Furnace: Check for Updates"
      },
      {
        "command": "aiGui.theme.create",
        "title": "Furnace: Create a Custom Theme"
      },
      {
        "command": "aiGui.theme.edit",
        "title": "Furnace: Edit Current Theme"
      },
      {
        "command": "aiGui.theme.pick",
        "title": "Furnace: Choose Theme"
      },
      {
        "command": "aiGui.theme.surprise",
        "title": "Furnace: Surprise Me (Random Theme)"
      },
      {
        "command": "aiGui.theme.useForProject",
        "title": "Furnace: Use This Theme for This Project"
      },
      {
        "command": "aiGui.theme.dayNight",
        "title": "Furnace: Day and Night Themes"
      },
      {
        "command": "aiGui.theme.toggleGlow",
        "title": "Furnace: Toggle Agent Glow"
      },
      {
        "command": "aiGui.theme.import",
        "title": "Furnace: Import Theme"
      },
      {
        "command": "aiGui.theme.export",
        "title": "Furnace: Export Current Theme"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aiGui",
          "title": "Conversation",
          "icon": "media/workspace.svg"
        }
      ],
      "activitybar": [
        {
          "id": "aiGuiWorkspace",
          "title": "Furnace Workspace",
          "icon": "media/workspace.svg"
        }
      ]
    },
    "views": {
      "aiGui": [
        {
          "id": "aiGui.conversation",
          "name": "Conversation",
          "type": "webview"
        }
      ],
      "aiGuiWorkspace": [
        {
          "id": "aiGui.workspace",
          "name": "Workspace",
          "type": "webview"
        }
      ]
    },
    "themes": [
      {
        "label": "Furnace Charcoal",
        "uiTheme": "vs-dark",
        "path": "./themes/charcoal.json"
      }
    ],
    "configuration": {
      "title": "Furnace",
      "properties": {
        "aiGui.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the product workspace and conversation on startup."
        },
        "aiGui.agent.permissions": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "full"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Ask before every file change, command and web fetch.",
            "Apply project edits directly and run commands in the sandbox (project + temp writes, no network); ask for anything else.",
            "Full access (YOLO): no approvals and no sandbox."
          ],
          "description": "How much the agent may do without asking. Changeable from the conversation composer."
        },
        "aiGui.agent.showCommandsInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Show the agent's commands and background processes live in IDE terminals (Ctrl+C there interrupts them)."
        },
        "aiGui.review.automatic": {
          "type": "boolean",
          "default": false,
          "description": "After each Build reply that changes files, a second model reviews the changes and its notes appear under the changed files (costs an extra request)."
        },
        "aiGui.review.model": {
          "type": "string",
          "default": "",
          "description": "Model that reviews changes (an id such as anthropic/claude-sonnet-5-5). Empty: the model that made the changes."
        },
        "aiGui.budget.monthlyUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Monthly API spend (US dollars) that Furnace warns about, counted from replies made with API keys on this machine. 0: no warning."
        },
        "aiGui.pricing": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              }
            }
          },
          "description": "Price overrides in US dollars per million tokens, keyed by model id, for example {\"openai/gpt-5\": {\"input\": 1.25, \"output\": 10}}."
        },
        "aiGui.window.opacity": {
          "type": "number",
          "default": 0.96,
          "minimum": 0.5,
          "maximum": 1,
          "description": "Window opacity, from 0.5 to 1 (opaque); also Display → Window Opacity. Applies on macOS, and on Linux with X11 and a compositing window manager; Wayland ignores it."
        },
        "aiGui.updates.check": {
          "type": "boolean",
          "default": true,
          "description": "Check once a day whether a newer Furnace is available (only when this build names an update feed). Nothing else is sent."
        },
        "aiGui.support.developerTools": {
          "type": "boolean",
          "default": false,
          "description": "Show Toggle Developer Tools and Process Explorer in release builds (for troubleshooting). Takes effect after a restart."
        },
        "aiGui.theme.current": {
          "type": "string",
          "default": "charcoal",
          "description": "The Furnace theme (Themes menu): a preset id such as charcoal, ember, midnight or paper, or a saved theme. Per-project themes (Themes → Use for This Project) take precedence."
        },
        "aiGui.theme.night": {
          "type": "string",
          "default": "",
          "description": "Theme shown when your system is in dark mode (Themes → Day and Night). Empty: one theme all day."
        },
        "aiGui.theme.agentGlow": {
          "type": "boolean",
          "default": false,
          "description": "A soft glow around the chat panel: the theme accent while the agent works, amber while it waits for you, red after an error."
        }
      }
    },
    "configurationDefaults": {
      "workbench.activityBar.location": "top",
      "workbench.layoutControl.enabled": false,
      "workbench.tips.enabled": false,
      "window.title": "${dirty}${rootName}${separator}Furnace",
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "gutter"
    },
    "menus": {
      "scm/resourceState/context": [
        {
          "command": "aiGui.scm.revert",
          "when": "scmProvider == aiGui && scmResourceState == revertible",
          "group": "inline"
        },
        {
          "command": "aiGui.scm.stage",
          "when": "scmProvider == aiGui",
          "group": "inline"
        },
        {
          "command": "aiGui.scm.revert",
          "when": "scmProvider == aiGui && scmResourceState == revertible",
          "group": "1_modification"
        },
        {
          "command": "aiGui.scm.stage",
          "when": "scmProvider == aiGui",
          "group": "1_modification"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "aiGui.scm.reviewAll",
          "when": "scmProvider == aiGui",
          "group": "inline"
        },
        {
          "command": "aiGui.scm.stageAll",
          "when": "scmProvider == aiGui",
          "group": "inline"
        }
      ],
      "scm/title": [
        {
          "command": "aiGui.focusConversation",
          "when": "scmProvider == aiGui",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "aiGui.scm.open",
          "when": "false"
        },
        {
          "command": "aiGui.scm.revert",
          "when": "false"
        },
        {
          "command": "aiGui.scm.stage",
          "when": "false"
        },
        {
          "command": "aiGui.inlineEdit.accept",
          "when": "aiGui.inlineEditPending"
        },
        {
          "command": "aiGui.inlineEdit.reject",
          "when": "aiGui.inlineEditPending"
        },
        {
          "command": "aiGui.inlineEdit.diff",
          "when": "aiGui.inlineEditPending"
        },
        {
          "command": "aiGui.inlineEdit.cancel",
          "when": "aiGui.inlineEditRunning"
        },
        {
          "command": "aiGui.agentHunk.keep",
          "when": "false"
        },
        {
          "command": "aiGui.agentHunk.revert",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "aiGui.inlineEdit",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aiGui.focusConversation",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "aiGui.newChat",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "aiGui.history",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      },
      {
        "command": "aiGui.nextMode",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "aiGui.home",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      },
      {
        "command": "aiGui.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "aiGui.busy"
      },
      {
        "command": "aiGui.approve",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "aiGui.approvalPending && !findWidgetVisible"
      },
      {
        "command": "aiGui.deny",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "aiGui.approvalPending"
      },
      {
        "command": "aiGui.inlineEdit",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && !editorReadonly && !aiGui.inlineEditPending"
      },
      {
        "command": "aiGui.inlineEdit.accept",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && aiGui.inlineEditPending"
      },
      {
        "command": "aiGui.inlineEdit.reject",
        "key": "escape",
        "when": "editorTextFocus && aiGui.inlineEditPending && !suggestWidgetVisible && !inlineSuggestionVisible && !findWidgetVisible"
      },
      {
        "command": "aiGui.inlineEdit.cancel",
        "key": "escape",
        "when": "aiGui.inlineEditRunning"
      }
    ]
  },
  "enabledApiProposals": [
    "workspaceTrust"
  ],
  "support": {
    "issues": "",
    "email": ""
  },
  "updates": {
    "feed": ""
  }
}
